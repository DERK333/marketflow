{
  "name": "Review Reminder",
  "description": "Emails the buyer to leave a review when a transaction is marked completed",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Transaction",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0",
      "name": "review_reminder",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendReviewReminder",
            "args": {
              "transaction_id": "${ .trigger.entity_id }",
              "workflow_secret": "mfrw-a9d4e7f2b6c8315d"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send review reminder email",
            "description": "Notifies the buyer"
          }
        }
      }
    ]
  }
}